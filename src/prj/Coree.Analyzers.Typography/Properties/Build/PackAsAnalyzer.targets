<Project>
  <!--
    Analyzer nupkgs put the assembly under analyzers/dotnet/cs, not lib/.
    IncludeBuildOutput is false on the csproj so the SDK does not also write lib/{tfm}/.
    This target runs during pack of netstandard2.0.
    AnalyzerPackage/Coree.Analyzers.Typography.props is the nupkg entry (build/ and
    buildTransitive/). Per-analyzer .props files next to it are imported from that entry.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAsAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(AnalyzerPackageSourcePath)\**\*.props" />
    <!-- Show disk copies under AnalyzerPackage; the buildTransitive pack projection stays hidden. -->
    <None Include="$(AnalyzerPackageSourcePath)\**\*.props" Pack="true" PackagePath="build\" Visible="true" />
    <None Include="$(AnalyzerPackageSourcePath)\**\*.props" Pack="true" PackagePath="buildTransitive\" Visible="false" />
  </ItemGroup>
  <Target Name="PackAsAnalyzer">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(TargetDir)$(TargetName).xml" PackagePath="analyzers/dotnet/cs" Condition="Exists('$(TargetDir)$(TargetName).xml')" />
    </ItemGroup>
  </Target>
</Project>
