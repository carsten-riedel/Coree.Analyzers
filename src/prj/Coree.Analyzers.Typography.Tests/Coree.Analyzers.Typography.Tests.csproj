<Project Sdk="Microsoft.NET.Sdk">

  <!-- DebugHost / test host TFM from the wizard. The analyzer under test is netstandard2.0. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Packaging and publish configuration -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <!-- Test configuration -->
  <PropertyGroup>
    <_MSTestResultsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'MSTestResults'))</_MSTestResultsDir>
    <VSTestLogger>trx%3bLogFileName=$(_MSTestResultsDir)$(MSBuildProjectName)-$(TargetFramework).trx;html%3bLogFileName=$(_MSTestResultsDir)result-$(TargetFramework).html</VSTestLogger>
  </PropertyGroup>

  <!-- coverlet.msbuild: CollectCoverage is enough for `dotnet test` on SDK MSBuild. -->
  <!-- Include is the packable analyzer only (sourceName). Threshold fails the test run when that assembly is under 100% line/branch/method total. -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>opencover,json</CoverletOutputFormat>
    <CoverletOutput>./CoverletOutput/</CoverletOutput>
    <Include>[Coree.Analyzers.Typography]*</Include>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>


  <!-- Package inventory of the packable analyzer, not this test project. -->
  <PropertyGroup>
    <NugetReportDir Condition=" '$(NugetReportDir)' == '' ">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'NugetReport'))</NugetReportDir>
    <NugetReportProject Condition=" '$(NugetReportProject)' == '' ">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'Coree.Analyzers.Typography', 'Coree.Analyzers.Typography.csproj'))</NugetReportProject>
  </PropertyGroup>
  <Target Name="WriteNugetReport" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <_NugetReportPrefix>$(NugetReportDir)$([System.IO.Path]::GetFileNameWithoutExtension('$(NugetReportProject)'))</_NugetReportPrefix>
    </PropertyGroup>
    <MakeDir Directories="$(NugetReportDir)" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package %3E &quot;$(_NugetReportPrefix)-packages.txt&quot;" IgnoreExitCode="true" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package --format json %3E &quot;$(_NugetReportPrefix)-packages.json&quot;" IgnoreExitCode="true" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package --include-transitive --vulnerable %3E &quot;$(_NugetReportPrefix)-vulnerable.txt&quot;" IgnoreExitCode="true" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package --include-transitive --vulnerable --format json %3E &quot;$(_NugetReportPrefix)-vulnerable.json&quot;" IgnoreExitCode="true" />
  </Target>



  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>

  <!-- Analyzer is netstandard2.0. Do not SetTargetFramework to the test TFM. -->
  <ItemGroup>
    <ProjectReference Include="..\Coree.Analyzers.Typography\Coree.Analyzers.Typography.csproj" />
  </ItemGroup>

  <!-- External dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.3" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
